{
  "schemaVersion": 1,
  "app": {
    "id": "app.helm.Helm",
    "name": "Helm",
    "site": "https://kaandis.github.io/helm/",
    "repository": "https://github.com/Kaandis/helm"
  },
  "defaultsDomain": "app.helm.Helm",
  "notes": "Every setting is a plain UserDefaults key in defaultsDomain and Helm reads them as it needs them, so changes apply at once. Launch at login is not listed: it is an SMAppService login item that only Helm itself can register. Helm needs no permissions. bigHelmTools is an array of tool identifiers that Helm's own settings window edits.",
  "groups": [
    {
      "id": "wheels",
      "title": {
        "en": "Wheels",
        "tr": "Çarklar"
      },
      "settings": [
        {
          "key": "convertKey",
          "type": "enum",
          "default": "shift",
          "options": [
            {
              "value": "shift",
              "title": {
                "en": "⇧ Shift",
                "tr": "⇧ Shift"
              }
            },
            {
              "value": "command",
              "title": {
                "en": "⌘ Command",
                "tr": "⌘ Command"
              }
            },
            {
              "value": "control",
              "title": {
                "en": "⌃ Control",
                "tr": "⌃ Control"
              }
            },
            {
              "value": "option",
              "title": {
                "en": "⌥ Option",
                "tr": "⌥ Option"
              }
            }
          ],
          "title": {
            "en": "Convert",
            "tr": "Dönüştür"
          }
        },
        {
          "key": "toolsKey",
          "type": "enum",
          "default": "command",
          "options": [
            {
              "value": "shift",
              "title": {
                "en": "⇧ Shift",
                "tr": "⇧ Shift"
              }
            },
            {
              "value": "command",
              "title": {
                "en": "⌘ Command",
                "tr": "⌘ Command"
              }
            },
            {
              "value": "control",
              "title": {
                "en": "⌃ Control",
                "tr": "⌃ Control"
              }
            },
            {
              "value": "option",
              "title": {
                "en": "⌥ Option",
                "tr": "⌥ Option"
              }
            }
          ],
          "title": {
            "en": "Tools",
            "tr": "Araçlar"
          }
        },
        {
          "key": "actionsKey",
          "type": "enum",
          "default": "control",
          "options": [
            {
              "value": "shift",
              "title": {
                "en": "⇧ Shift",
                "tr": "⇧ Shift"
              }
            },
            {
              "value": "command",
              "title": {
                "en": "⌘ Command",
                "tr": "⌘ Command"
              }
            },
            {
              "value": "control",
              "title": {
                "en": "⌃ Control",
                "tr": "⌃ Control"
              }
            },
            {
              "value": "option",
              "title": {
                "en": "⌥ Option",
                "tr": "⌥ Option"
              }
            }
          ],
          "title": {
            "en": "Actions",
            "tr": "Eylemler"
          }
        },
        {
          "key": "keyMode",
          "type": "enum",
          "default": "hold",
          "options": [
            {
              "value": "hold",
              "title": {
                "en": "Hold to show",
                "tr": "Basılı tutunca göster"
              }
            },
            {
              "value": "toggle",
              "title": {
                "en": "Press to switch",
                "tr": "Basınca geç"
              }
            }
          ],
          "title": {
            "en": "Keys",
            "tr": "Tuşlar"
          },
          "description": {
            "en": "Hold: a wheel shows while its key is down. Press: a press picks the wheel until pressed again.",
            "tr": "Basılı tut: tuş basılıyken çark görünür. Bas: bir basış çarkı seçer, yeniden basana kadar kalır."
          }
        },
        {
          "key": "shakeToOpen",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Shake a drag to see every tool",
            "tr": "Tüm araçlar için sürüklerken salla"
          },
          "description": {
            "en": "There and back and there again, side to side or up and down, opens a big helm with every tool that fits.",
            "tr": "Sağa sola ya da yukarı aşağı, gidip gelip yeniden gidince, uyan tüm araçların olduğu büyük dümen açılır."
          }
        },
        {
          "key": "shakeSensitivity",
          "type": "enum",
          "default": "normal",
          "options": [
            {
              "value": "low",
              "title": {
                "en": "Low",
                "tr": "Düşük"
              }
            },
            {
              "value": "normal",
              "title": {
                "en": "Normal",
                "tr": "Normal"
              }
            },
            {
              "value": "high",
              "title": {
                "en": "High",
                "tr": "Yüksek"
              }
            }
          ],
          "title": {
            "en": "Shake sensitivity",
            "tr": "Sallama hassasiyeti"
          },
          "visibleWhen": {
            "shakeToOpen": true
          }
        },
        {
          "key": "skipFullScreen",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Stay out of full-screen apps",
            "tr": "Tam ekran uygulamalarda açılma"
          }
        },
        {
          "key": "excludedApps",
          "type": "appList",
          "itemType": "bundleIdentifier",
          "default": [],
          "title": {
            "en": "Excluded apps",
            "tr": "Hariç tutulan uygulamalar"
          },
          "description": {
            "en": "Wheels never open while dragging in these apps, for apps whose own drag shortcuts clash.",
            "tr": "Bu uygulamalarda sürüklerken çark hiç açılmaz; kendi sürükleme kısayolları çakışan uygulamalar için."
          }
        }
      ]
    },
    {
      "id": "look",
      "title": {
        "en": "Helm",
        "tr": "Dümen"
      },
      "settings": [
        {
          "key": "panelStyle",
          "type": "enum",
          "default": "glass",
          "options": [
            {
              "value": "cream",
              "title": {
                "en": "Cream",
                "tr": "Krem"
              }
            },
            {
              "value": "glass",
              "title": {
                "en": "Liquid Glass",
                "tr": "Liquid Glass"
              },
              "requires": {
                "macOS": "26.0"
              }
            }
          ],
          "title": {
            "en": "Appearance",
            "tr": "Görünüm"
          }
        },
        {
          "key": "accentColor",
          "type": "enum",
          "default": "graphite",
          "options": [
            {
              "value": "pebble",
              "title": {
                "en": "Pebble",
                "tr": "Çakıl"
              }
            },
            {
              "value": "sky",
              "title": {
                "en": "Sky",
                "tr": "Gök"
              }
            },
            {
              "value": "mint",
              "title": {
                "en": "Mint",
                "tr": "Nane"
              }
            },
            {
              "value": "lilac",
              "title": {
                "en": "Lilac",
                "tr": "Leylak"
              }
            },
            {
              "value": "sun",
              "title": {
                "en": "Sun",
                "tr": "Güneş"
              }
            },
            {
              "value": "coral",
              "title": {
                "en": "Coral",
                "tr": "Mercan"
              }
            },
            {
              "value": "graphite",
              "title": {
                "en": "Graphite",
                "tr": "Grafit"
              }
            },
            {
              "value": "system",
              "title": {
                "en": "System",
                "tr": "Sistem"
              }
            }
          ],
          "title": {
            "en": "Rim",
            "tr": "Çember"
          }
        },
        {
          "key": "helmTransparency",
          "type": "number",
          "default": 0.3,
          "min": 0,
          "max": 0.8,
          "step": 0.05,
          "title": {
            "en": "Transparency",
            "tr": "Şeffaflık"
          },
          "description": {
            "en": "How much shows through the helm's ring.",
            "tr": "Dümenin halkasından ne kadarının görüneceği."
          }
        },
        {
          "key": "helmSize",
          "type": "enum",
          "default": "medium",
          "options": [
            {
              "value": "small",
              "title": {
                "en": "Small",
                "tr": "Küçük"
              }
            },
            {
              "value": "medium",
              "title": {
                "en": "Medium",
                "tr": "Orta"
              }
            },
            {
              "value": "large",
              "title": {
                "en": "Large",
                "tr": "Büyük"
              }
            }
          ],
          "title": {
            "en": "Size",
            "tr": "Boyut"
          }
        },
        {
          "key": "helmShape",
          "type": "enum",
          "default": "round",
          "options": [
            {
              "value": "round",
              "title": {
                "en": "Round",
                "tr": "Yuvarlak"
              }
            },
            {
              "value": "square",
              "title": {
                "en": "Square",
                "tr": "Kare"
              }
            }
          ],
          "title": {
            "en": "Shape",
            "tr": "Şekil"
          }
        },
        {
          "key": "showHandles",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Handles around the rim",
            "tr": "Çemberin etrafında tutamaklar"
          }
        }
      ]
    },
    {
      "id": "bighelm",
      "title": {
        "en": "Big Helm",
        "tr": "Büyük Dümen"
      },
      "settings": [
        {
          "key": "bigHelmShowsAll",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Show every tool that fits",
            "tr": "Uyan tüm araçları göster"
          },
          "description": {
            "en": "Turn off to choose the tools in Helm's settings (Big Helm).",
            "tr": "Araçları Helm'in ayarlarından (Büyük Dümen) seçmek için kapat."
          }
        }
      ]
    },
    {
      "id": "results",
      "title": {
        "en": "Results",
        "tr": "Sonuçlar"
      },
      "settings": [
        {
          "key": "saveLocation",
          "type": "enum",
          "default": "nextToOriginal",
          "options": [
            {
              "value": "nextToOriginal",
              "title": {
                "en": "Next to the original",
                "tr": "Orijinalin yanına"
              }
            },
            {
              "value": "downloads",
              "title": {
                "en": "Downloads",
                "tr": "İndirilenler"
              }
            }
          ],
          "title": {
            "en": "Save results",
            "tr": "Sonuçları kaydet"
          }
        },
        {
          "key": "revealResults",
          "type": "bool",
          "default": false,
          "title": {
            "en": "Show results in Finder",
            "tr": "Sonuçları Finder'da göster"
          }
        },
        {
          "key": "AppleLanguages",
          "type": "language",
          "default": null,
          "options": [
            {
              "value": null,
              "title": {
                "en": "System",
                "tr": "Sistem"
              }
            },
            {
              "value": [
                "en"
              ],
              "title": {
                "en": "English",
                "tr": "English"
              }
            },
            {
              "value": [
                "tr"
              ],
              "title": {
                "en": "Türkçe",
                "tr": "Türkçe"
              }
            }
          ],
          "restartRequired": true,
          "title": {
            "en": "Language",
            "tr": "Dil"
          },
          "description": {
            "en": "Remove the key to follow the system language.",
            "tr": "Sistem dilini izlemek için anahtarı kaldır."
          }
        }
      ]
    }
  ]
}