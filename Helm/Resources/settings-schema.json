              "value": "mint",
              "title": {
                "en": "Mint",
                "tr": "Nane"
              }
            },
            {
              "value": "lilac",
              "title": {
                "en": "Lilac",
                "tr": "Leylak"
              }
            },
            {
              "value": "sun",
              "title": {
                "en": "Sun",
                "tr": "Güneş"
              }
            },
            {
              "value": "coral",
              "title": {
                "en": "Coral",
                "tr": "Mercan"
              }
            },
            {
              "value": "graphite",
              "title": {
                "en": "Graphite",
                "tr": "Grafit"
              }
            },
            {
              "value": "system",
              "title": {
                "en": "System",
                "tr": "Sistem"
              }
            }
          ],
          "title": {
            "en": "Rim",
            "tr": "Çember"
          }
        },
        {
          "key": "helmTransparency",
          "type": "number",
          "default": 0.3,
          "min": 0,
          "max": 0.8,
          "step": 0.05,
          "title": {
            "en": "Transparency",
            "tr": "Şeffaflık"
          },
          "description": {
            "en": "How much shows through the helm's ring.",
            "tr": "Dümenin halkasından ne kadarının görüneceği."
          }
        },
        {
          "key": "helmSize",
          "type": "enum",
          "default": "medium",
          "options": [
            {
              "value": "small",
              "title": {
                "en": "Small",
                "tr": "Küçük"
              }
            },
            {
              "value": "medium",
              "title": {
                "en": "Medium",
                "tr": "Orta"
              }
            },
            {
              "value": "large",
              "title": {
                "en": "Large",
                "tr": "Büyük"
              }
            }
          ],
          "title": {
            "en": "Size",
            "tr": "Boyut"
          }
        },
        {
          "key": "helmShape",
          "type": "enum",
          "default": "round",
          "options": [
            {
              "value": "round",
              "title": {
                "en": "Round",
                "tr": "Yuvarlak"
              }
            },
            {
              "value": "square",
              "title": {
                "en": "Square",
                "tr": "Kare"
              }
            }
          ],
          "title": {
            "en": "Shape",
            "tr": "Şekil"
          }
        },
        {
          "key": "showHandles",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Handles around the rim",
            "tr": "Çemberin etrafında tutamaklar"
          }
        }
      ]
    },
    {
      "id": "bighelm",
      "title": {
        "en": "Big Helm",
        "tr": "Büyük Dümen"
      },
      "settings": [
        {
          "key": "bigHelmShowsAll",
