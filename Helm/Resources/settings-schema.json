{
  "schemaVersion": 1,
  "app": {
    "id": "app.helm.Helm",
    "name": "Helm",
    "site": "https://kaandis.github.io/helm/",
    "repository": "https://github.com/Kaandis/helm",
    "ownSettings": {
      "title": {
        "en": "Arrange the Big Helm…",
        "tr": "Büyük Dümeni Düzenle…"
      },
      "section": "bighelm"
    }
  },
  "defaultsDomain": "app.helm.Helm",
  "notes": "Every setting is a plain UserDefaults key in defaultsDomain and Helm reads them as it needs them, so changes apply at once. Launch at login is not listed: it is an SMAppService login item that only Helm itself can register. Helm needs no permissions.",
  "groups": [
    {
      "id": "wheels",
      "title": {
        "en": "Wheels",
        "tr": "Çarklar"
      },
      "settings": [
        {
          "key": "convertKey",
          "type": "enum",
          "default": "shift",
          "options": [
            {
              "value": "shift",
              "title": {
                "en": "⇧ Shift",
                "tr": "⇧ Shift"
              }
            },
            {
              "value": "command",
              "title": {
                "en": "⌘ Command",
                "tr": "⌘ Command"
              }
            },
            {
              "value": "control",
              "title": {
                "en": "⌃ Control",
                "tr": "⌃ Control"
              }
            },
            {
              "value": "option",
              "title": {
                "en": "⌥ Option",
                "tr": "⌥ Option"
              }
            }
          ],
          "title": {
            "en": "Convert",
            "tr": "Dönüştür"
          }
        },
        {
          "key": "toolsKey",
          "type": "enum",
          "default": "command",
          "options": [
            {
              "value": "shift",
              "title": {
                "en": "⇧ Shift",
                "tr": "⇧ Shift"
              }
            },
            {
              "value": "command",
              "title": {
                "en": "⌘ Command",
                "tr": "⌘ Command"
              }
            },
            {
              "value": "control",
              "title": {
                "en": "⌃ Control",
                "tr": "⌃ Control"
              }
            },
            {
              "value": "option",
              "title": {
                "en": "⌥ Option",
                "tr": "⌥ Option"
              }
            }
          ],
          "title": {
            "en": "Tools",
            "tr": "Araçlar"
          }
        },
        {
          "key": "actionsKey",
          "type": "enum",
          "default": "control",
          "options": [
            {
              "value": "shift",
              "title": {
                "en": "⇧ Shift",
                "tr": "⇧ Shift"
              }
            },
            {
              "value": "command",
              "title": {
                "en": "⌘ Command",
                "tr": "⌘ Command"
              }
            },
            {
              "value": "control",
              "title": {
                "en": "⌃ Control",
                "tr": "⌃ Control"
              }
            },
            {
              "value": "option",
              "title": {
                "en": "⌥ Option",
                "tr": "⌥ Option"
              }
            }
          ],
          "title": {
            "en": "Actions",
            "tr": "Eylemler"
          }
        },
        {
          "key": "keyMode",
          "type": "enum",
          "default": "hold",
          "options": [
            {
              "value": "hold",
              "title": {
                "en": "Hold to show",
                "tr": "Basılı tutunca göster"
              }
            },
            {
              "value": "toggle",
              "title": {
                "en": "Press to switch",
                "tr": "Basınca geç"
              }
            }
          ],
          "title": {
            "en": "Keys",
            "tr": "Tuşlar"
          },
          "description": {
            "en": "Hold: a wheel shows while its key is down. Press: a press picks the wheel until pressed again.",
            "tr": "Basılı tut: tuş basılıyken çark görünür. Bas: bir basış çarkı seçer, yeniden basana kadar kalır."
          }
        },
        {
          "key": "shakeToOpen",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Shake a drag to see every tool",
            "tr": "Tüm araçlar için sürüklerken salla"
          },
          "description": {
            "en": "There and back and there again, side to side or up and down, opens a big helm with every tool that fits.",
            "tr": "Sağa sola ya da yukarı aşağı, gidip gelip yeniden gidince, uyan tüm araçların olduğu büyük dümen açılır."
          }
        },
        {
          "key": "shakeSensitivity",
          "type": "enum",
          "default": "normal",
          "options": [
            {
              "value": "low",
              "title": {
                "en": "Low",
                "tr": "Düşük"
              }
            },
            {
              "value": "normal",
              "title": {
                "en": "Normal",
                "tr": "Normal"
              }
            },
            {
              "value": "high",
              "title": {
                "en": "High",
                "tr": "Yüksek"
              }
            }
          ],
          "title": {
            "en": "Shake sensitivity",
            "tr": "Sallama hassasiyeti"
          },
          "visibleWhen": {
            "shakeToOpen": true
          }
        },
        {
          "key": "skipFullScreen",
          "type": "bool",
          "default": true,
          "title": {
            "en": "Stay out of full-screen apps",
            "tr": "Tam ekran uygulamalarda açılma"
          }
        },
        {
          "key": "excludedApps",
          "type": "appList",
          "itemType": "bundleIdentifier",
          "default": [],
          "title": {
            "en": "Excluded apps",
            "tr": "Hariç tutulan uygulamalar"
          },
          "description": {
            "en": "Wheels never open while dragging in these apps, for apps whose own drag shortcuts clash.",
            "tr": "Bu uygulamalarda sürüklerken çark hiç açılmaz; kendi sürükleme kısayolları çakışan uygulamalar için."
          }
        }
      ]
    },
    {
      "id": "look",
      "title": {
        "en": "Helm",
        "tr": "Dümen"
      },
      "settings": [
