    "Copy Text": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni Kopyala"
          }
        }
      }
    },
    "Couldn’t convert the audio.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses dönüştürülemedi."
          }
        }
      }
    },
    "Couldn’t read %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ okunamadı."
          }
        }
      }
    },
    "Couldn’t save %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kaydedilemedi."
          }
        }
      }
    },
    "Cut": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kes"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Drag the shelf into a folder, or press ⌥⌘V there.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafı bir klasöre sürükle ya da orada ⌥⌘V'ye bas."
          }
        }
      }
    },
    "Drag to a folder to move": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşımak için bir klasöre sürükle"
          }
        }
      }
    },
    "Drag, hold a key, drop": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükle, tuşa bas, bırak"
          }
        }
      }
    },
    "Drop on a tool. The result lands next to the original; drop in the middle, or outside, to cancel.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aracın üstüne bırak. Sonuç orijinalin yanına gelir; vazgeçmek için ortaya ya da dışarı bırak."
          }
        }
      }
    },
    "Drop outside to cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeçmek için dışarı bırak"
          }
        }
      }
    },
    "Excluded Apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç Uygulamalar"
          }
        }
      }
    },
    "Extract": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aç"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel"
          }
        }
      }
    },
    "Give each wheel its own key.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çarka ayrı bir tuş ver."
          }
        }
      }
    },
    "Got It": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anladım"
          }
        }
      }
    },
    "HEIC": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC"
          }
        }
      }
    },
    "Half Size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarı Boyut"
          }
        }
      }
    },
    "Helm stays out of full-screen apps, and you can turn it off for apps whose own drag shortcuts clash, or pause it from the menu bar.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm tam ekran uygulamalarda açılmaz; sürükleme kısayolları çakışan uygulamalar için kapatabilir ya da menü çubuğundan duraklatabilirsin."
          }
        }
      }
    },
    "Helm turns, shrinks and sends your files right where you drag them, with nothing to open first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm dosyalarını sürüklediğin yerde dönüştürür, küçültür ve gönderir; önce hiçbir şey açman gerekmez."
          }
        }
      }
    },
    "Hold a key to narrow it down": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daraltmak için bir tuşa bas"
          }
        }
      }
    },
    "Hold while dragging": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüklerken basılı tut"
          }
        }
      }
    },
    "Hold ⇧ to convert, ⌘ for tools, or ⌃ for actions. A wheel opens under the pointer. Or shake the files side to side to see every tool at once.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüştürmek için ⇧, araçlar için ⌘, eylemler için ⌃ tuşuna bas; işaretçinin altında bir çark açılır. Ya da tüm araçları birden görmek için dosyaları sağa sola salla."
          }
        }
      }
    },
    "How to Use Helm…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm Nasıl Kullanılır…"
          }
        }
      }
    },
    "Image copied": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel kopyalandı"
          }
        }
      }
    },
    "Images": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görseller"
          }
        }
      }
    },
