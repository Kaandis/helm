            "value": "Büyük dümende"
          }
        }
      }
    },
    "There and back and there again, side to side or up and down. Higher sensitivity takes a smaller, slower shake.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git, gel, yeniden git; sağa sola ya da yukarı aşağı. Hassasiyet yükseldikçe daha küçük ve yavaş bir sallama yeter."
          }
        }
      }
    },
