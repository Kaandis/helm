      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kod bulunamadı"
          }
        }
      }
    },
    "No apps yet. Wheels open everywhere except full-screen apps.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz uygulama yok. Çarklar tam ekran uygulamalar dışında her yerde açılır."
