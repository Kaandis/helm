    "Welcome to Helm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm'e Hoş Geldin"
          }
        }
      }
    },
    "Wheels don’t open while these apps are in front, so their own drag shortcuts keep working.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamalar öndeyken çarklar açılmaz, böylece kendi sürükleme kısayolları çalışmaya devam eder."
