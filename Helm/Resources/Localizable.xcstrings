    "The archive couldn’t be made.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv oluşturulamadı."
          }
        }
      }
    },
    "This Mac can’t write %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac %@ yazamıyor."
          }
        }
      }
    },
    "This file can’t be exported that way.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bu biçimde dışa aktarılamıyor."
          }
        }
