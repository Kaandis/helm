    "A photo is dragged with Shift held; the wheel opens and the photo is dropped on JPG.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift basılıyken bir fotoğraf sürükleniyor; çark açılıyor ve fotoğraf JPG'nin üstüne bırakılıyor."
          }
        }
      }
    },
    "A wheel shows while you hold its key. After a shake, letting go brings the big helm back.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşunu basılı tuttuğun sürece çark görünür. Salladıktan sonra bırakınca büyük dümen geri gelir."
          }
        }
      }
    },
