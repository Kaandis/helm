      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfalara Böl"
          }
        }
      }
    },
    "Start dragging files in Finder or on the desktop.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder'da ya da masaüstünde dosyaları sürüklemeye başla."
          }
        }
      }
    },
    "Stay out of full-screen apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran uygulamalarda açılma"
          }
        }
      }
    },
    "Strip Metadata": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgileri Sil"
          }
        }
      }
    },
