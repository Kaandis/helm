    "A photo is dragged with Shift held; the wheel opens and the photo is dropped on JPG.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift basılıyken bir fotoğraf sürükleniyor; çark açılıyor ve fotoğraf JPG'nin üstüne bırakılıyor."
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylemler"
          }
        }
      }
    },
    "Add App…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama Ekle…"
          }
